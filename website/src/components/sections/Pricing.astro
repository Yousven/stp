---
import { site } from "../../config/site";
import { t, type Locale } from "../../i18n";
import Cta from "../ui/Cta.astro";

/**
 * S9 — hind.
 *
 * Üks hind, ilma astmeteta, sest tootel neid ei ole. Kolme kunstlikku
 * "tier'i" siia ei ehitata ainult sellepärast, et SaaS-lehtedel neid
 * tavaliselt on.
 *
 * Number ja prooviperiood tulevad `site.config`-ist, mis omakorda kattub
 * API koodiga (`PRICE_PER_SEAT_EUR`, `TRIAL_DAYS`).
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale).pricing;
const { pricePerSeatEur, trialDays } = site.pricing;
---

<section class="price" id="pricing" aria-labelledby="price-heading">
  <div class="price__head">
    <span class="hud price__label">{d.sectionLabel}</span>
    <h2 id="price-heading" class="display price__heading">
      {d.heading.map((line) => <span class="price__heading-line">{line}</span>)}
    </h2>
  </div>

  <div class="price__main">
    <div class="price__figure">
      {/* Oranž joon numbri kohal tõmmatakse kerides. */}
      <span class="price__rule" aria-hidden="true"></span>
      <span class="display price__amount">{d.amount(pricePerSeatEur)}</span>
      <span class="hud price__per">{d.per}</span>
      <span class="price__trial">{d.trial(trialDays)}</span>
    </div>

    <div class="price__side">
      <p class="price__body">{d.body}</p>
      <ul class="price__includes">
        {d.includes.map((item) => <li class="price__include">{item}</li>)}
      </ul>
      <div class="price__cta">
        {/* Ilma märkuseta: prooviperiood on juba numbri juures oranži
            sildina ja kaks korda sama lause loeks välja nagu viga. */}
        <Cta label={d.cta} location="pricing" />
      </div>
    </div>
  </div>
</section>

<style>
  .price {
    border-top: 1px solid var(--hairline);
    background: var(--asphalt-sunk);
    padding: clamp(4rem, 12vh, 8rem) var(--gutter) clamp(4rem, 10vh, 7rem);
  }

  .price__head {
    display: grid;
    gap: 0.9rem;
    margin-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .price__label {
    color: var(--signal);
  }

  .price__heading {
    font-size: clamp(2.1rem, 5.6vw, 5.2rem);
    margin: 0;
  }

  .price__heading-line {
    display: block;
    white-space: nowrap;
  }

  .price__main {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  /* --- Number --- */

  .price__figure {
    position: relative;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    padding-top: clamp(1.25rem, 3vh, 2rem);
  }

  .price__rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--signal);
    transform-origin: left center;
  }

  .price__amount {
    font-size: clamp(4.5rem, 14vw, 12rem);
    line-height: 0.8;
    color: var(--concrete);
  }

  .price__per {
    color: var(--concrete-dim);
  }

  .price__trial {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--hud-size);
    letter-spacing: var(--hud-tracking);
    text-transform: uppercase;
    color: var(--asphalt);
    background: var(--signal);
    padding: 0.4rem 0.7rem;
  }

  /* --- Selgitus --- */

  .price__body {
    margin: 0;
    color: var(--concrete-dim);
    max-width: 44ch;
  }

  .price__includes {
    list-style: none;
    margin: clamp(1.5rem, 4vh, 2.25rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .price__include {
    padding-left: 1.6rem;
    position: relative;
    color: var(--concrete);
  }

  /* Linnuke tehakse joonest, mitte ikooniteegist — sama põhimõte mis
     äpi ikoonidel. */
  .price__include::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.6rem;
    height: 0.32rem;
    border-left: 1.5px solid var(--verified);
    border-bottom: 1.5px solid var(--verified);
    transform: rotate(-45deg);
  }

  .price__cta {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }

  @media (max-width: 899px) {
    .price__heading {
      font-size: clamp(1.9rem, 8.5vw, 3.2rem);
    }

    .price__heading-line {
      white-space: normal;
    }

    .price__main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .price__amount {
      font-size: clamp(4rem, 26vw, 7rem);
    }
  }
</style>

<script>
  import { motion, DESKTOP, NARROW, gsap, hideLines, drawX, UNMASKED } from "../../lib/motion";

  /*
   * S9 — üks suur number (intensiivsus ~50 %).
   *
   * Vähe liikuvaid osi, aga see, mis liigub, on suur. Number tuleb
   * skaalaga sisse, kõik ülejäänu tuleb hiljem ja väiksemalt — nii jääb
   * lugejale ainult üks asi meelde.
   */
  motion("pricing", ".price", ({ q, all, when }) => {
    when({ wide: DESKTOP, narrow: NARROW }, (self) => {
      const wide = !!self.conditions?.wide;
      const k = wide ? 1 : 0.6;

      const headLines = all(".price__heading-line");
      const label = q(".price__label");
      const rule = q(".price__rule");
      const amount = q(".price__amount");
      const per = q(".price__per");
      const trial = q(".price__trial");
      const body = q(".price__body");
      const includes = all(".price__include");
      const cta = q(".price__cta");

      hideLines(headLines);
      drawX(rule);
      gsap.set(label, { opacity: 0, x: -10 });
      gsap.set(amount, { opacity: 0, scale: 0.85, transformOrigin: "0% 100%" });
      gsap.set([per, trial], { opacity: 0, y: 14 * k });
      gsap.set(body, { opacity: 0, y: 14 * k });
      gsap.set(includes, { opacity: 0, x: -12 * k });
      gsap.set(cta, { opacity: 0, y: 14 * k });

      const head = gsap.timeline({
        scrollTrigger: { trigger: ".price__head", start: "top 86%", end: "top 50%", scrub: 0.5 },
        defaults: { ease: "power2.out" },
      });
      head
        .to(label, { opacity: 1, x: 0, duration: 0.3 })
        .to(headLines, { ...UNMASKED, duration: 0.5, stagger: 0.14 }, 0.08);

      const main = gsap.timeline({
        scrollTrigger: { trigger: ".price__main", start: "top 84%", end: "bottom 78%", scrub: 0.6 },
        defaults: { ease: "power3.out" },
      });
      main
        .to(rule, { scaleX: 1, duration: 0.4 })
        .to(amount, { opacity: 1, scale: 1, duration: 0.7 }, 0.05)
        .to(per, { opacity: 1, y: 0, duration: 0.35 }, 0.45)
        .to(body, { opacity: 1, y: 0, duration: 0.4 }, 0.45)
        .to(trial, { opacity: 1, y: 0, duration: 0.35 }, 0.62)
        .to(includes, { opacity: 1, x: 0, duration: 0.35, stagger: 0.08 }, 0.6)
        .to(cta, { opacity: 1, y: 0, duration: 0.4 }, 0.85);

      return () => {
        [head, main].forEach((a) => {
          a.scrollTrigger?.kill();
          a.kill();
        });
      };
    });
  });
</script>
