// See skeem on koostatud praeguse PHP-rakenduse (public/*.php) päringute põhjal.
// ENNE toodangu andmebaasiga ühendamist käivita `npm run prisma:pull`, mis
// loeb päris tabelistruktuuri Proxmoxi MySQL-ist ja parandab siin võimalikud
// ebatäpsused (nt täpsed veerutüübid, indeksid, mis siit puuduvad).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        Int          @id @default(autoincrement())
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(100)
  createdAt DateTime     @default(now()) @map("created_at")
  users     User[]
  objects   WorkObject[]
  settings  Setting[]

  @@map("organizations")
}

model User {
  id             Int             @id @default(autoincrement())
  organizationId Int             @map("organization_id")
  username       String          @db.VarChar(255)
  password       String          @db.VarChar(255)
  email          String          @db.VarChar(255)
  hourlyRate     Decimal         @map("hourly_rate") @db.Decimal(10, 2)
  advance        Decimal         @db.Decimal(10, 2)
  role           String          @db.VarChar(20) // "admin" | "employee"
  organization   Organization    @relation(fields: [organizationId], references: [id])
  timeLogs       TimeLog[]
  passwordResets PasswordReset[]

  @@unique([organizationId, username])
  @@unique([organizationId, email])
  @@map("users")
}

model WorkObject {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("organization_id")
  name           String       @db.VarChar(255)
  description    String?      @db.Text
  address        String?      @db.VarChar(255)
  latitude       Decimal      @db.Decimal(10, 7)
  longitude      Decimal      @db.Decimal(10, 7)
  radius         Int
  deleted        Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id])
  timeLogs       TimeLog[]

  @@map("objects")
}

model TimeLog {
  id             Int         @id @default(autoincrement())
  userId         Int         @map("user_id")
  objectId       Int         @map("object_id")
  startTime      DateTime    @map("start_time")
  endTime        DateTime?   @map("end_time")
  startLatitude  Decimal?    @map("start_latitude") @db.Decimal(10, 7)
  startLongitude Decimal?    @map("start_longitude") @db.Decimal(10, 7)
  comment        String?     @db.Text
  travelDuration Decimal?    @map("travel_duration") @db.Decimal(5, 2)
  lunch          Decimal?    @db.Decimal(5, 2)
  manualWorkDuration Decimal? @map("manual_work_duration") @db.Decimal(5, 2)

  user           User            @relation(fields: [userId], references: [id])
  object         WorkObject      @relation(fields: [objectId], references: [id])
  presenceEvents PresenceEvent[]

  @@map("time_logs")
}

// Append-only kohaloleku sündmuste logi: iga objekti raadiusesse
// sisenemine/väljumine. Petmisvastase tööriista puhul on auditijälg
// olulisem kui kompaktne "kokku väljas X minutit" loendur — admin peab
// hiljem nägema, millal täpselt lahkuti ja naasti.
model PresenceEvent {
  id         Int      @id @default(autoincrement())
  timeLogId  Int      @map("time_log_id")
  type       String   @db.VarChar(10) // "ENTER" | "EXIT"
  occurredAt DateTime @map("occurred_at")
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(10, 2)
  source     String   @db.VarChar(20) // "manual" | "foreground" | "native"

  timeLog TimeLog @relation(fields: [timeLogId], references: [id], onDelete: Cascade)

  // Idempotentsus: natiivne järjekord võib sama sündmuse partii korduvalt
  // saata (nt kui üleslaadimine katkes pärast serveri kirjutamist).
  @@unique([timeLogId, type, occurredAt])
  @@index([timeLogId, occurredAt])
  @@map("presence_events")
}

model Setting {
  organizationId Int          @map("organization_id")
  key            String       @map("setting_key") @db.VarChar(100)
  value          String       @map("setting_value") @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([organizationId, key])
  @@map("settings")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_resets")
}
