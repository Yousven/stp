# Kopeeri see failiks .env ja täida päris väärtused. .env EI TOHI kunagi jõuda gitti.

# MySQL ühendus. Arenduses osutab local docker-compose MySQL konteinerile;
# toodangus (Proxmox) osutab olemasolevale MySQL instantsile ja olemasolevale
# `time_tracking` andmebaasile (vaata ../config/config.php).
DATABASE_URL="mysql://app:password@localhost:3306/time_tracking"

# Kasutusel ainult deploy/docker-compose.with-mysql.yml-iga (kui serveril
# pole veel olemasolevat MySQL-i) — sama parool, mis DATABASE_URL-is.
MYSQL_APP_PASSWORD="password"

# JWT saladused - genereeri unikaalsed, pikad juhuslikud stringid, nt:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3000

# Lubatud CORS päritolud (komaga eraldatult), nt mobiiliäpi dev-server ja Capacitor
CORS_ORIGIN="http://localhost:5173,capacitor://localhost,http://localhost,https://localhost"

# --- Teavitused ---
# Kõik allolev on VALIKULINE. Kui puudub, logitakse teavitused konsooli ja
# rakendus töötab edasi — nii saab kogu loogikat arendada ilma mandaatideta.

# Ajavöönd, mille järgi arvutatakse meeldetuletuste tähtajad ja "täna".
TZ_NAME="Europe/Tallinn"

# Firebase Cloud Messaging (push). Väärtused tulevad Firebase'i service
# account JSON-ist (Project settings -> Service accounts -> Generate new
# private key). Vt api/README.md "Push-teavituste seadistamine".
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
# NB! Kogu võti ühel real, reavahetused \n-idena (nii nagu JSON-is on).
FCM_PRIVATE_KEY=""

# SMTP meeldetuletuste e-kirjade jaoks (nt Gmaili app password või oma server).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SmartTimePlanning <no-reply@example.com>"

# Meeldetuletuste taustatöö (iga 15 min). Arenduses võib välja lülitada.
REMINDERS_ENABLED="true"

# --- Tellimused (Stripe) ---
# Ilma nendeta töötab prooviperiood, aga makset vastu võtta ei saa.
# STRIPE_PRICE_ID peab olema korduva (recurring) hinna ID, mille
# arveldusmudel on "per unit" — kogus = aktiivsete kasutajate arv.
PRICE_PER_SEAT_EUR=5
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
# Webhook'i saladus: Stripe Dashboard -> Developers -> Webhooks.
# Endpoint: https://sinu-domeen/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Vigade jälgimine (valikuline)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# Avalik aadress, mille peale ehitatakse parooli taastamise ja
# tellimuse tagasisuunamise lingid.
APP_URL="http://localhost:5173"
