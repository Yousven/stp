# Kopeeri see failiks .env ja täida päris väärtused. .env EI TOHI kunagi jõuda gitti.

# MySQL ühendus. Arenduses osutab local docker-compose MySQL konteinerile;
# toodangus (Proxmox) osutab olemasolevale MySQL instantsile ja olemasolevale
# `time_tracking` andmebaasile (vaata ../config/config.php).
DATABASE_URL="mysql://app:password@localhost:3306/time_tracking"

# Kasutusel ainult deploy/docker-compose.with-mysql.yml-iga (kui serveril
# pole veel olemasolevat MySQL-i) — sama parool, mis DATABASE_URL-is.
MYSQL_APP_PASSWORD="password"

# JWT saladused - genereeri unikaalsed, pikad juhuslikud stringid, nt:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

PORT=3000

# Lubatud CORS päritolud (komaga eraldatult), nt mobiiliäpi dev-server ja Capacitor
CORS_ORIGIN="http://localhost:5173,capacitor://localhost,http://localhost,https://localhost"
